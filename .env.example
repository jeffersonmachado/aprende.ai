# Configurações obrigatórias em produção
JWT_SECRET=TROQUE_POR_UM_SEGREDO_FORTE_DE_32_CHARS

# Banco de dados
DB_NAME=aprende_ai
DB_USER=postgres
DB_PASSWORD=TROQUE_PELA_SENHA_DO_BANCO
DB_LOGGING=false

# Ambiente
NODE_ENV=production

# CORS — domínio do frontend
CORS_ORIGIN=https://seudominio.com

# Portas (opcionais, default: api=3015, frontend=8088)
# API_PORT=3015
# FRONTEND_PORT=8088

# Frontend (build-time)
VITE_TENANT_SLUG=demo
# Apache subpath
VITE_APP_BASE_PATH=/aprende-ai/
VITE_API_BASE_URL=/aprende-ai
